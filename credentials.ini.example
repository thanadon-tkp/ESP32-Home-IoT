; ──────────────────────────────────────────────────
; Copy this file to credentials.ini and fill in your values.
; credentials.ini is gitignored and will NOT be committed.
; ──────────────────────────────────────────────────

[credentials]
build_flags =
    -D WIFI_SSID=\"Your_SSID\"
    -D WIFI_PASSWORD=\"Your_Password\"
    -D MQTT_SERVER=\"192.168.x.x\"
    -D MQTT_PORT=1883
